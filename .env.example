# Application
APP_NAME=Sentinel Workbench
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Database
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# Security
SECRET_KEY=change-me-in-production-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC / Keycloak
OIDC_ENABLED=true
OIDC_ISSUER_URL=https://your-keycloak-domain.com/realms/sentinel
OIDC_CLIENT_ID=sentinel-workbench
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=https://your-domain.com/callback
OIDC_SCOPES=openid profile email roles

# LLM Providers
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# CORS
CORS_ORIGINS=["https://your-domain.com"]

# Privacy Mode
PRIVACY_ENABLED=false
PRIVACY_MASK_CHAR=█
PRIVACY_RULES=["secret", "email", "phone", "card", "iban", "ip"]
PRIVACY_ALLOW_HOSTS=["github.com", "learn.microsoft.com"]

# Agent Settings
AGENT_DETECT_SECONDS=2
AGENT_QUIET_WINDOWS=[]
